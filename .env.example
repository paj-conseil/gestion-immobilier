# Auth.js
NEXTAUTH_SECRET="change-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Envoi d'emails (SMTP Yahoo — mot de passe d'application, pas votre mot de passe Yahoo)
SMTP_HOST="smtp.mail.yahoo.com"
SMTP_PORT="465"
SMTP_USER="pierrejaubert@yahoo.com"
SMTP_PASSWORD=""
SMTP_FROM="Pilotage locatif <pierrejaubert@yahoo.com>"

# Stockage des fichiers uploadés / documents générés
STORAGE_DIR="./storage"

# Coordonnées du bailleur, utilisées dans les documents générés (contrat, quittance...)
